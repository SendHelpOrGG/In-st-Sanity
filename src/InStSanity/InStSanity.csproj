<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows desktop only. Bump the Windows SDK band / .NET version here if needed. -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<OutputType>Exe</OutputType>
		<RootNamespace>InStSanity</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- App identity -->
		<ApplicationTitle>In-st-Sanity</ApplicationTitle>
		<ApplicationId>com.instsanity.app</ApplicationId>
		<ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
		<ApplicationDisplayVersion>1.143</ApplicationDisplayVersion>
		<ApplicationVersion>12</ApplicationVersion>

		<!-- Unpackaged desktop app: run it straight from the build output (F5 / dotnet run), no MSIX required. -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Keep managed satellite resources in English only. -->
		<SatelliteResourceLanguages>en;en-GB;en-US</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#15181D" />
		<!-- Keep the source icon in build output for AppWindow.SetIcon; MauiIcon supplies the publish copy. -->
		<Content Include="Resources\AppIcon\appicon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" TargetPath="appicon.ico" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#111318" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Side-panel icons are rendered at 20x20 (same size the MAUI templates use for fly-out icons). -->
		<MauiImage Update="Resources\Images\icon_home.png" Resize="True" BaseSize="20,20" />

		<!-- Raw assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- WindowsAppSDKSelfContained copies .mui folders from its framework package and does not honor SatelliteResourceLanguages. Keep English variants in publish; remove only non-English folders that contain MUI resources. -->
	<Target Name="RemoveNonEnglishWindowsAppSdkLanguageFolders"
			AfterTargets="Publish"
			Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<_EnglishMuiPattern Include="$(PublishDir)en\*.mui" />
			<_EnglishMuiPattern Include="$(PublishDir)en-*\*.mui" />
			<_NonEnglishMuiFile Include="$(PublishDir)*\*.mui" Exclude="@(_EnglishMuiPattern)" />
			<_NonEnglishMuiDirectory Include="@(_NonEnglishMuiFile-&gt;'%(RootDir)%(Directory)')" />
		</ItemGroup>
		<RemoveDir Directories="@(_NonEnglishMuiDirectory)" />
	</Target>

</Project>
