<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows desktop only. Bump the Windows SDK band / .NET version here if needed. -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<OutputType>Exe</OutputType>
		<RootNamespace>InStSanity</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- App identity -->
		<ApplicationTitle>In-st-Sanity</ApplicationTitle>
		<ApplicationId>com.instsanity.app</ApplicationId>
		<ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
		<ApplicationDisplayVersion>1.25</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Unpackaged desktop app: run it straight from the build output (F5 / dotnet run), no MSIX required. -->
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#15181D" />
		<!-- Win32 icon for the exe + a copy at the app root so the window can pin the same icon. -->
		<Content Include="Resources\AppIcon\appicon.ico" CopyToOutputDirectory="PreserveNewest" TargetPath="appicon.ico" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#111318" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<!-- Side-panel icons are rendered at 20x20 (same size the MAUI templates use for fly-out icons). -->
		<MauiImage Update="Resources\Images\icon_home.png" Resize="True" BaseSize="20,20" />

		<!-- Raw assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

</Project>
